<?xml version="1.0"?>
<launch>
    <arg name="skip_frame" default="0"/>
    <arg name="i_frame_only" default="false"/>

    <!-- Camera stream + integrated FFmpeg decode in one process -->
    <node pkg="insta360_ros_driver" exec="insta360_ros_driver_decoded" name="insta360_decoded_node" output="screen">
        <param name="skip_frame" value="$(var skip_frame)"/>
        <param name="i_frame_only" value="$(var i_frame_only)"/>
    </node>
</launch>
