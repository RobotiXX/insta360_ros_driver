<?xml version="1.0"?>
<launch>
  <arg name="equirectangular_config" default="$(find-pkg-share insta360_ros_driver)/config/x4_calibration.yaml"/>

  <node
    name="equirectangular_node"
    pkg="insta360_ros_driver"
    exec="insta360_ros_driver_decoded_equirectangular_gst"
    output="screen">
    <param name="skip_frame" value="0" />
    <param name="i_frame_only" value="false" />
    <param from="$(var equirectangular_config)" />
  </node>
</launch>
