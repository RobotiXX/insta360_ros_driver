<?xml version="1.0"?>
<launch>
    <arg name="skip_frame" default="0"/>
    <arg name="i_frame_only" default="false"/>
    <arg name="enable_in_camera_stitching" default="false"/>
    <arg name="hw_decoder_name" default="h264_nvv4l2dec"/>

    <!-- Strict Jetson FFmpeg hardware decode node (no software fallback). -->
    <node pkg="insta360_ros_driver" exec="insta360_ros_driver_decoded_ffmpeg_hw" name="insta360_decoded_ffmpeg_hw_node" output="screen">
        <param name="skip_frame" value="$(var skip_frame)"/>
        <param name="i_frame_only" value="$(var i_frame_only)"/>
        <param name="enable_in_camera_stitching" value="$(var enable_in_camera_stitching)"/>
        <param name="hw_decoder_name" value="$(var hw_decoder_name)"/>
    </node>
</launch>
