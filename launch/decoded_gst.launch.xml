<?xml version="1.0"?>
<launch>
  <arg name="skip_frame" default="0"/>
  <arg name="i_frame_only" default="false"/>
  <arg name="use_hw_decoder" default="true"/>
  <arg name="low_latency_mode" default="true"/>

  <node
    name="insta360_decoded_gst_node"
    pkg="insta360_ros_driver"
    exec="insta360_ros_driver_decoded_gst"
    output="screen">
    <param name="skip_frame" value="$(var skip_frame)"/>
    <param name="i_frame_only" value="$(var i_frame_only)"/>
    <param name="use_hw_decoder" value="$(var use_hw_decoder)"/>
    <param name="low_latency_mode" value="$(var low_latency_mode)"/>
  </node>
</launch>
